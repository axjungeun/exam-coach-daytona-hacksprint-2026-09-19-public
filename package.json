{
  "name": "exam-coach-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare_pdf_worker.mjs",
    "prebuild": "node scripts/prepare_pdf_worker.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:study": "wrangler deploy --config wrangler.study.jsonc",
    "dev:study": "wrangler dev --config wrangler.study.jsonc",
    "test": "npm run check:practice && npm run check:vocabulary && npm run check:synthetic && npm run check:evidence && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "sponsor:bright": "node scripts/sponsors/bright_data_refresh.mjs",
    "sponsor:daytona": "node scripts/sponsors/daytona_validate.mjs",
    "sponsor:nosana": "node scripts/sponsors/nosana_batch_job.mjs",
    "sponsor:check": "node scripts/sponsors/field_check.mjs",
    "sponsor:live": "node scripts/sponsors/field_check.mjs --live",
    "check:practice": "node scripts/check_public_practice_bank.mjs",
    "check:vocabulary": "node scripts/apply_exam_vocabulary_standard.mjs",
    "check:synthetic": "node scripts/generate_synthetic_learners.mjs --check",
    "check:evidence": "node scripts/check_live_evidence_fixture.mjs",
    "prompt:record": "node scripts/prompt_behavior_tracker.mjs add",
    "prompt:report": "node scripts/prompt_behavior_tracker.mjs analyze",
    "synthetic:generate": "node scripts/generate_synthetic_learners.mjs",
    "synthetic:seed": "npm run synthetic:generate && wrangler d1 execute exam-coach-data --remote --file output/synthetic/agent-forge-50-v1.sql",
    "synthetic:clear": "wrangler d1 execute exam-coach-data --remote --file output/synthetic/agent-forge-50-v1-clear.sql"
  },
  "dependencies": {
    "@daytona/sdk": "^0.204.1",
    "@nosana/kit": "^2.7.4",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.21.3"
  },
  "type": "module"
}
